[Unit]
Description=Qwill server dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/server-dashboard/current
ExecStart=/opt/server-dashboard/current/.venv/bin/python -m dashboard
Environment=PYTHONUNBUFFERED=1
Environment=DASHBOARD_PORT=5100
Environment=CADDY_SERVICE_NAME=caddy.service
Environment=DASHBOARD_STATE_DIR=/var/lib/server-dashboard
UMask=0077
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
